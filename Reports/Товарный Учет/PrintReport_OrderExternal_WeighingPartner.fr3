 clNone;&#13;&#10;      Memo3.Color := clNone;  &#13;&#10;      Memo23.Color := clNone;&#13;&#10;      Memo30.Color := clNone;            &#13;&#10;      Memo40.Color := clNone;&#13;&#10;      //Memo39.Color := clNone;&#13;&#10;      //Memo42.Color := clNone;            &#13;&#10;&#13;&#10;      Memo80.Color := clNone;  &#13;&#10;      Memo76.Color := clNone;  &#13;&#10;      Memo82.Color := clNone;  &#13;&#10;       &#13;&#10;      Memo15.Color := clNone;  &#13;&#10;      Memo12.Color := clNone;  &#13;&#10;      Memo11.Color := clNone;                   &#13;&#10;  &#13;&#10;    end;&#13;&#10;end;&#13;&#10;  &#13;&#10;&#13;&#10;&#13;&#10; &#13;&#10;procedure Memo48OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    if (&#60;frxDBDMaster.&#34;Amount_child_diff&#34;&#62; &#62; 0) then        &#13;&#10;    begin                &#13;&#10;         //Memo48.Font.Color := clRed;&#13;&#10;         //Memo48.Font.Size := 9;&#13;&#10;         //Memo48.Font.Style := fsBold;&#13;&#10;         //Memo48.Color := cl3DLight;  &#13;&#10;&#13;&#10;        &#13;&#10;    end&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;     Page1.Visible:= &#60;isGroupGoods&#62; = FALSE;                                                 &#13;&#10;     Page2.Visible:= (&#60;isGroupGoods&#62; = TRUE);                      &#13;&#10;end." PropData="">
